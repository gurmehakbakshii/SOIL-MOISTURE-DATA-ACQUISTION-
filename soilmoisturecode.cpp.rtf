\f0\fs24 \cf0 #include <Wire.h>\
#include <LiquidCrystal_I2C.h>\
\
LiquidCrystal_I2C lcd(0x27, 16, 2);\
\
int sensorPin = A0;\
int ledPin = 9;   // PWM pin\
\
void setup()\
\{\
  pinMode(ledPin, OUTPUT);\
\
  lcd.init();\
  lcd.backlight();\
  Serial.begin(9600);\
\}\
\
void loop()\
\{\
  int moistureValue = analogRead(sensorPin);\
\
  // Convert to percentage\
  int moisturePercent = map(moistureValue, 1023, 0, 0, 100);\
\
  // Convert percentage to LED brightness (0\'96255)\
  int brightness = map(moisturePercent, 0, 100, 0, 255);\
\
  analogWrite(ledPin, brightness);\
\
  lcd.clear();\
  lcd.setCursor(0,0);\
  lcd.print("Moisture: ");\
  lcd.print(moisturePercent);\
  lcd.print("%");\
\
  lcd.setCursor(0,1);\
\
  if(moisturePercent <= 30)\
  \{\
    lcd.print("Status: DRY");\
  \}\
  else if(moisturePercent <= 70)\
  \{\
    lcd.print("Status: MODERATE");\
  \}\
  else\
  \{\
    lcd.print("Status: WET");\
  \}\
\
  Serial.print("Moisture: ");\
  Serial.println(moisturePercent);\
\
  delay(800);\
\}}